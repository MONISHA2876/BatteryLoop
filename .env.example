# Existing deployed contracts — Flow EVM Testnet
# Official network: chain ID 545, RPC https://testnet.evm.nodes.onflow.org
# Explorer: https://evm-testnet.flowscan.io  (Flow Developer Portal)
NEXT_PUBLIC_FLOW_EVM_CHAIN_ID=545
NEXT_PUBLIC_BATTERY_PASSPORT_ADDRESS=
NEXT_PUBLIC_BATTERY_LIFECYCLE_ADDRESS=
NEXT_PUBLIC_CIRCULARITY_REWARDS_ADDRESS=

# Optional public RPC / explorer overrides
NEXT_PUBLIC_FLOW_EVM_RPC_URL=https://testnet.evm.nodes.onflow.org
NEXT_PUBLIC_FLOW_EVM_EXPLORER_URL=https://evm-testnet.flowscan.io
FLOW_EVM_RPC_URL=https://testnet.evm.nodes.onflow.org

# Server-side AI integration (never use a NEXT_PUBLIC_ prefix)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

# Database — SQLite for local development
DATABASE_URL="file:./dev.db"

# Session signing secret (32+ random characters). Server-only.
AUTH_SECRET=

# Optional: bootstrap application ADMIN / RECYCLER roles on first wallet sign-in
# These are app roles, not Solidity AccessControl roles.
APP_ADMIN_WALLETS=
APP_RECYCLER_WALLETS=
